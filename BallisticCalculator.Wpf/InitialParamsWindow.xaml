<Window x:Class="BallisticCalculator.Wpf.InitialParamsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Начальные условия" Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Массы -->
                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,5,5" Text="Масса ГЧ (MassGo), кг:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,0,0,5" Text="{Binding MassGo, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,5,5" Text="Масса 1-й ступени (Mass1), кг:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,0,0,5" Text="{Binding Mass1, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,5,5" Text="Масса 2-й ступени (Mass2), кг:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,0,0,5" Text="{Binding Mass2, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,5,5" Text="Масса 3-й ступени (Mass3), кг:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,0,0,5" Text="{Binding Mass3, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Массы топлива -->
                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,10,5,5" Text="Масса топлива 1-й ступени (MassFuel1), кг:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="4" Grid.Column="1" Margin="0,10,0,5" Text="{Binding MassFuel1, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,5,5" Text="Масса топлива 2-й ступени (MassFuel2), кг:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="5" Grid.Column="1" Margin="0,0,0,5" Text="{Binding MassFuel2, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,5,5" Text="Масса топлива 3-й ступени (MassFuel3), кг:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="6" Grid.Column="1" Margin="0,0,0,5" Text="{Binding MassFuel3, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Тяга -->
                <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,10,5,5" Text="Тяга 1-й ступени (Thrust1), Н:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="7" Grid.Column="1" Margin="0,10,0,5" Text="{Binding Thrust1, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,0,5,5" Text="Тяга 2-й ступени (Thrust2), Н:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="8" Grid.Column="1" Margin="0,0,0,5" Text="{Binding Thrust2, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,0,5,5" Text="Тяга 3-й ступени (Thrust3), Н:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="9" Grid.Column="1" Margin="0,0,0,5" Text="{Binding Thrust3, UpdateSourceTrigger=PropertyChanged}" />

                <!-- УИ -->
                <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,10,5,5" Text="УИ 1-й ступени (Isp1):" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="10" Grid.Column="1" Margin="0,10,0,5" Text="{Binding Isp1, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="11" Grid.Column="0" Margin="0,0,5,5" Text="УИ 2-й ступени (Isp2):" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="11" Grid.Column="1" Margin="0,0,0,5" Text="{Binding Isp2, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="12" Grid.Column="0" Margin="0,0,5,5" Text="УИ 3-й ступени (Isp3):" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="12" Grid.Column="1" Margin="0,0,0,5" Text="{Binding Isp3, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Margin="0,10,10,0" IsCancel="True">Отмена</Button>
            <Button Width="100" Margin="0,10,0,0" IsDefault="True" Click="OkButton_Click">OK</Button>
        </StackPanel>
    </Grid>
</Window>

