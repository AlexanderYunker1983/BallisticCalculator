<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Целевая платформа: .NET 10 под Windows 10+ -->
    <TargetFramework>net10.0-windows</TargetFramework>

    <!-- WPF-приложение без WinForms -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>

    <!-- Современные настройки компилятора -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- DPI-aware манифест -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Self-contained деплой под Windows 10+ (x64) -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <RootNamespace>BallisticCalculator.Wpf</RootNamespace>
    <AssemblyName>BallisticCalculator.Wpf</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.1.0" />
  </ItemGroup>
</Project>


