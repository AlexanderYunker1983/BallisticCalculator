<Window x:Class="BallisticCalculator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:vm="clr-namespace:BallisticCalculator.Wpf.ViewModels"
        Title="Баллистический калькулятор" Height="900" Width="1600">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="10">
        <!-- Основное содержимое, блокируется при IsBusy -->
        <Grid IsEnabled="{Binding IsNotBusy}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Width="100" Height="30" Margin="0,0,10,0"
                        Command="{Binding RunCommand}">Старт</Button>

                <Button Width="150" Height="30" Margin="0,0,10,0"
                        Click="InitialParamsButton_Click">Начальные условия</Button>

                <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="Время φ₁:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBox Width="80"
                             Text="{Binding Phi1Time, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="Угол φ₁ (°):" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBox Width="80"
                             Text="{Binding Phi1Degrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Скорость:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding VelocityInfo}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Высота:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding AltitudeInfo}" />
                </StackPanel>
            </StackPanel>

            <TabControl Grid.Row="1" VerticalAlignment="Stretch">
                <TabItem Header="Скорость / Высота">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <oxy:PlotView Grid.Column="0"
                                      Margin="0,0,5,0"
                                      Model="{Binding VelocityPlotModel}" />
                        <oxy:PlotView Grid.Column="1"
                                      Margin="5,0,0,0"
                                      Model="{Binding AltitudePlotModel}" />
                    </Grid>
                </TabItem>
                <TabItem Header="Углы">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <oxy:PlotView Grid.Column="0"
                                      Margin="0,0,5,0"
                                      Model="{Binding AlphaPlotModel}" />
                        <oxy:PlotView Grid.Column="1"
                                      Margin="5,0,0,0"
                                      Model="{Binding PhiPlotModel}" />
                    </Grid>
                </TabItem>
                <TabItem Header="Перегрузка">
                    <Grid Margin="5">
                        <oxy:PlotView Model="{Binding OverloadPlotModel}" />
                    </Grid>
                </TabItem>
                <TabItem Header="Ортодромная дальность">
                    <Grid Margin="5">
                        <oxy:PlotView Model="{Binding OrthodromicRangePlotModel}" />
                    </Grid>
                </TabItem>
                <TabItem Header="Профиль высоты">
                    <Grid Margin="5">
                        <oxy:PlotView Model="{Binding HeightProfilePlotModel}" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Оверлей во время расчёта -->
        <Grid Background="#80000000" Grid.Row="0"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
              IsHitTestVisible="True">
            <Border Width="320"
                    Height="180"
                    Background="#F0FFFFFF"
                    CornerRadius="8"
                    Padding="20"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Width="220"
                                 Height="20"
                                 Margin="0,0,0,10" />
                    <TextBlock Text="Идёт расчёт, пожалуйста подождите"
                               TextAlignment="Center"
                               FontSize="14"
                               Margin="0,0,0,10" />
                    <Button Width="120"
                            Height="30"
                            Command="{Binding RunCancelCommand}">
                        Отмена
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

